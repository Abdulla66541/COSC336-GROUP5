        +expire() void
    }
    class Request {
        +int requestId
        +String category
        +String purpose
        +String specifications
        +int quantity
        +String preferredCondition
        +Urgency urgency
        +String location
        +Date requiredDate
        +RequestStatus status
        +cancel() void
        +canEdit() boolean
    }
    class Reservation {
        +int reservationId
        +int quantity
        +DateTime reservedAt
        +DateTime expiresAt
        +ReservationStatus status
        +isExpired() boolean
        +release() void
    }
    class WatchlistItem {
        +int watchId
        +String savedSearch
    }
    class AssetStatus {
        <<enumeration>>
        Draft
        Registered
        AvailablePublished
        Reserved
        InTransfer
        InMaintenance
        Retired
        Donated
        Recycled
        Disposed
    }
    class RequestStatus {
        <<enumeration>>
        Draft
        Submitted
        MatchedReserved
        Approved
        Rejected
        Cancelled
        Expired
        Fulfilled
    }
    class Urgency {
        <<enumeration>>
        Low
        Medium
        High
    }
    class ListingStatus {
        <<enumeration>>
        Active
        Withdrawn
        Expired
    }
    class ReservationStatus {
        <<enumeration>>
        Active
        Expired
        Released
        Converted
    }

    class AssetService {
        +registerAsset(data) Asset
